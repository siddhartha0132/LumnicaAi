# ============================================================
# LUMNICA AI — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ─── Server ─────────────────────────────────────────────────
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# ─── AI Providers ────────────────────────────────────────────
# Google Gemini (FREE tier - https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# NVIDIA NIM (FREE tier - https://build.nvidia.com)
# Optional - uses Gemini if not set. NVIDIA has higher rate limits.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TEMPERATURE=0.5
NVIDIA_MAX_TOKENS=2048

# ─── Demo Mode ─────────────────────────────────────────────
# Set to 'true' to use mock data without API keys
DEMO_MODE=false

# ─── Rate Limiting ──────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_SKIP_HEALTH=false

# ─── File Upload ────────────────────────────────────────────
MAX_FILE_SIZE=5242880

# ─── ML Settings ────────────────────────────────────────────
ML_CONFIDENCE_THRESHOLD=0.65
SKIN_DETECTION_THRESHOLD=0.08
ML_FALLBACK_TO_GEMINI=true

# ─── Logging ────────────────────────────────────────────────
LOG_LEVEL=debug

# ─── CORS ──────────────────────────────────────────────────
CORS_ORIGIN=*
CORS_CREDENTIALS=false

# ─── Roboflow (Optional) ────────────────────────────────────
# For advanced skin concern detection
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL=