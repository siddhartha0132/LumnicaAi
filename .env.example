# NVIDIA NIM API Keys (3 separate keys, one per model)
# Get from: https://build.nvidia.com
NVIDIA_API_KEY_TEXT=nvapi-your_text_key_here
NVIDIA_API_KEY_VISION=nvapi-your_vision_key_here
NVIDIA_API_KEY_VISION_FALLBACK=nvapi-your_fallback_key_here

# Models (defaults are set in config, only override if needed)
# NVIDIA_MODEL=meta/llama-4-maverick-17b-128e-instruct
# NVIDIA_VISION_MODEL=meta/llama-3.2-90b-vision-instruct
# NVIDIA_VISION_FALLBACK_MODEL=nvidia/llama-3.1-nemotron-nano-vl-8b-v1

# Server
PORT=5000
NODE_ENV=production
DEMO_MODE=false
SUGGEST_PRODUCTS=false
