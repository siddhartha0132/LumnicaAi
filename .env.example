# Server-side photo analysis: OpenRouter first, then NVIDIA, then the browser's on-device model.
# OpenRouter: https://openrouter.ai/keys . Models are tried in order; ":free" ones work on a free key
# but are often busy. With credit, put a fast paid model first, e.g. google/gemini-2.5-flash-lite.
OPENROUTER_API_KEY=sk-or-v1-your_key_here
# OPENROUTER_MODELS=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,google/gemma-4-31b-it:free,qwen/qwen3.8-27b:free
# OPENROUTER_TIMEOUT_MS=20000
# NVIDIA_TIMEOUT_MS=15000

# NVIDIA NIM: fallback photo analysis
# Get a key from https://build.nvidia.com
NVIDIA_API_KEY=nvapi-your_key_here
# NVIDIA_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Server
PORT=5000
NODE_ENV=production
DEMO_MODE=false
SUGGEST_PRODUCTS=false

# Opt-in "help improve Lumnica" photo sharing + feedback storage.
# Leave unset to disable (the app then hides the option and stores nothing).
# Cloudflare R2 (or any S3-compatible storage):
# CONTRIB_S3_BUCKET=lumnica-contributions
# CONTRIB_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# CONTRIB_S3_ACCESS_KEY_ID=
# CONTRIB_S3_SECRET_ACCESS_KEY=
# Local folder, for development only (Render's disk is wiped on every deploy):
# CONTRIB_LOCAL_DIR=./contrib_data
